{
  "name": "mm12-desafio",
  "version": "2.0.0",
  "description": "Controle de estoque com autenticação, perfis de acesso e histórico de movimentações — desafio técnico MM12 (Ionic + Angular + Firebase).",
  "author": "Bizzye",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:demo": "ng serve --configuration demo",
    "build": "ng build",
    "build:demo": "ng build --configuration demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI --coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "screenshots": "playwright test --project=screenshots",
    "deploy": "ng build && firebase deploy --only hosting",
    "android:sync": "npm run build:demo && cap sync android",
    "android:open": "cap open android",
    "android:assets": "node scripts/generate-android-assets.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@ionic/angular": "^9.0.6",
    "firebase": "^12.19.0",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~6.0.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
